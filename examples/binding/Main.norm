package binding

import micronaut.data.model.annotation.MappedEntity
import micronaut.data.model.pageableFrom

@MappedEntity(value: "messages")
class Message {
}

Void main() {
  require(condition: Message.class.annotation<MappedEntity>() != null, message: "MappedEntity binding is missing")
  var pageable = pageableFrom(arg0: 2, arg1: 25)
  require(condition: pageable?.getNumber() == 2 && pageable?.getSize() == 25, message: "Pageable binding changed")
  printLine(pageable?.getNumber() ?? 0)
  printLine(pageable?.getSize() ?? 0)
}
